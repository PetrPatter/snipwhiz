<UserControl x:Class="Snipwhiz.App.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:Snipwhiz.App.Editor">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#26241F"/>
        <SolidColorBrush x:Key="Ink" Color="#F5F2EC"/>
        <SolidColorBrush x:Key="InkMuted" Color="#8F8A80"/>
        <SolidColorBrush x:Key="Accent" Color="#E8833A"/>

        <!-- Icon-only rail button. Active tool fills with the accent. -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#332B2823"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#1C1B1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Thin left rail: icon-only, per the approved design direction. -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}"
                CornerRadius="14" Margin="0,0,0,0" Padding="8,10" VerticalAlignment="Stretch">
            <!-- Named because the code-behind enumerates these rather than keeping a
                 second hand-written list of them to forget to update. -->
            <StackPanel x:Name="ToolRail" VerticalAlignment="Top">
                <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xE8B0;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Select  (V)" IsChecked="True"/>
                <ToggleButton x:Name="RectToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xE739;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Rectangle  (R)"/>
                <ToggleButton x:Name="EllipseToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xEA3A;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Ellipse  (E)"/>
                <ToggleButton x:Name="LineToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Line  (L)"/>
                <ToggleButton x:Name="ArrowToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Arrow  (A)"/>
                <ToggleButton x:Name="HighlightToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xE7E6;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Highlight  (H)"/>
                <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolButton}"
                              Content="&#xE8D2;" FontFamily="Segoe MDL2 Assets"
                              ToolTip="Text  (T)"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Background="{StaticResource Surface}" CornerRadius="14" ClipToBounds="True">
                    <editor:CanvasHost x:Name="Canvas"/>
                </Border>

                <!-- The contextual pill, floating over the canvas rather than in a
                     permanent side panel. Its own layer so it is not clipped into
                     the canvas border and so hit-testing reaches it first. -->
                <!-- No Background: a Canvas with none hit-tests only its children, so
                     drawing on the surface underneath still works everywhere except
                     on the pill itself. Set it to Transparent and the layer swallows
                     every press meant for the canvas. -->
                <Canvas x:Name="PillLayer">
                    <Border x:Name="StylePill" Visibility="Collapsed"
                            Background="#F226241F" CornerRadius="11"
                            BorderBrush="#2EF5F2EC" BorderThickness="1"
                            Padding="10,7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- Filled in code: seven near-identical XAML blocks is
                                 seven places to edit the palette. -->
                            <StackPanel x:Name="SwatchRow" Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Border Width="1" Background="#2EF5F2EC" Margin="9,2,9,2"/>
                            <TextBlock Text="&#xE76D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource InkMuted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="WidthSlider" Width="88" VerticalAlignment="Center"
                                    Minimum="0" Maximum="24"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ToolTip="Stroke width"/>
                            <TextBlock x:Name="WidthText" Width="20" TextAlignment="Right"
                                       Foreground="{StaticResource Ink}" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>

            <Grid Grid.Row="1" Margin="6,10,6,0">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource InkMuted}" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZoomText"
                           Foreground="{StaticResource InkMuted}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
