<UserControl x:Class="Snipwhiz.App.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:Snipwhiz.App.Editor">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#26241F"/>
        <SolidColorBrush x:Key="Ink" Color="#F5F2EC"/>
        <SolidColorBrush x:Key="InkMuted" Color="#8F8A80"/>
        <SolidColorBrush x:Key="Accent" Color="#E8833A"/>

        <!--
          The ground the capture lies on, and the one surface in the app that is
          lighter than the chrome around it.

          It used to be Surface, the same near-black as the window. That made the
          shadow under the picture black on near-black, so it could not register at
          all - and a white capture therefore had no shadow, no visible hairline, and
          nothing but its own brightness to say where it ended. Lifting the ground
          gives the shadow something to darken, and gives a dark capture something to
          contrast with. It is also what every image editor does: dark panels, lighter
          artboard.
        -->
        <SolidColorBrush x:Key="CanvasGround" Color="#2B2825"/>

        <!--
          The two halves of the slider track. Templated to bare Borders because a
          RepeatButton's default template is a raised Aero chrome button, and two of
          them are what made the stroke-width control look like it had been dropped
          in from another program.
        -->
        <Style x:Key="SliderTrackFilled" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- Transparent, not none: the whole track has to stay
                             clickable so a click jumps the thumb to it. -->
                        <Border Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                    Background="{StaticResource Accent}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackFilled}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                    Background="#3DF5F2EC"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderTrackFilled}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Fill="{StaticResource Ink}"
                                                         Stroke="#1C1B1A" StrokeThickness="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Fill"
                                                                Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The gap between one family of tools and the next. A line rather than extra
          space alone: fourteen icons spaced apart still read as fourteen icons, and
          the line is what makes them read as six groups.
        -->
        <Style x:Key="ToolGroupBreak" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#24F5F2EC"/>
            <Setter Property="Margin" Value="6,5,6,7"/>
        </Style>

        <!-- Quiet until pointed at: the status line is the least important row here. -->
        <Style x:Key="ZoomButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="5" Background="Transparent"
                                Padding="7,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#332B2823"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only rail button. Active tool fills with the accent. -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#332B2823"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#1C1B1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
          Thin left rail: icon-only, per the approved design direction.

          The rail sizes to its tools instead of stretching the window. Stretched, it
          was a full-height wall of surface with the last third empty, which said the
          rail was the important thing on screen. It is not; the picture is.

          The ScrollViewer is not decoration. Fourteen 36px buttons and five group
          breaks come to roughly 590px, and the window's MinHeight is 420 - so at the
          smallest allowed size the rail genuinely does not fit, and before this it
          silently clipped Crop and Pixelate off the bottom with no way to reach them.
        -->
        <ScrollViewer x:Name="ToolRailScroller" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="{StaticResource SurfaceRaised}"
                    CornerRadius="14" Padding="8,9" VerticalAlignment="Top">
                <!-- Named because the code-behind enumerates these rather than keeping a
                     second hand-written list of them to forget to update. It filters on
                     ToggleButton, so the group breaks below cost it nothing. -->
                <StackPanel x:Name="ToolRail">
                    <!-- Select: not a drawing tool, so it stands alone. -->
                    <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE8B0;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Select  (V)" IsChecked="True"/>

                    <Border Style="{StaticResource ToolGroupBreak}"/>

                    <!-- Draw: a shape you drag out. -->
                    <ToggleButton x:Name="RectToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE739;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Rectangle  (R)"/>
                    <ToggleButton x:Name="EllipseToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xEA3A;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Ellipse  (E)"/>
                    <ToggleButton x:Name="LineToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Line  (L)"/>
                    <ToggleButton x:Name="ArrowToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Arrow  (A)"/>
                    <ToggleButton x:Name="HighlightToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE7E6;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Highlight  (H)"/>

                    <Border Style="{StaticResource ToolGroupBreak}"/>

                    <!-- Label: puts words or a number on the picture. -->
                    <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE8D2;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Text  (T)"/>
                    <ToggleButton x:Name="CalloutToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE8BD;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Callout  (O)"/>
                    <ToggleButton x:Name="StepToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Step number  (N)"/>

                    <Border Style="{StaticResource ToolGroupBreak}"/>

                    <!-- Emphasise: draws the eye to part of the picture. -->
                    <ToggleButton x:Name="MagnifyToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE71E;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Magnify  (M)"/>
                    <ToggleButton x:Name="SpotlightToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE706;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Spotlight  (S)"/>

                    <Border Style="{StaticResource ToolGroupBreak}"/>

                    <!-- Conceal: destroys what is underneath, which is why it is its own group. -->
                    <ToggleButton x:Name="BlurToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE890;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Blur  (B)"/>
                    <ToggleButton x:Name="PixelateToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE71F;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Pixelate  (P)"/>

                    <Border Style="{StaticResource ToolGroupBreak}"/>

                    <!-- Crop changes the picture itself rather than what is drawn on it. -->
                    <ToggleButton x:Name="CropToolButton" Style="{StaticResource ToolButton}"
                                  Content="&#xE7A8;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Crop  (C)" Margin="0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Background="{StaticResource CanvasGround}" CornerRadius="14" ClipToBounds="True">
                    <editor:CanvasHost x:Name="Canvas"/>
                </Border>

                <!-- The contextual pill, floating over the canvas rather than in a
                     permanent side panel. Its own layer so it is not clipped into
                     the canvas border and so hit-testing reaches it first. -->
                <!-- No Background: a Canvas with none hit-tests only its children, so
                     drawing on the surface underneath still works everywhere except
                     on the pill itself. Set it to Transparent and the layer swallows
                     every press meant for the canvas. -->
                <Canvas x:Name="PillLayer">
                    <Border x:Name="StylePill" Visibility="Collapsed"
                            Background="#F226241F" CornerRadius="11"
                            BorderBrush="#2EF5F2EC" BorderThickness="1"
                            Padding="10,7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- Filled in code: seven near-identical XAML blocks is
                                 seven places to edit the palette. -->
                            <StackPanel x:Name="SwatchRow" Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Border Width="1" Background="#2EF5F2EC" Margin="9,2,9,2"/>
                            <TextBlock Text="&#xE76D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource InkMuted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="WidthSlider" Width="88" VerticalAlignment="Center"
                                    Style="{StaticResource PillSlider}"
                                    Minimum="0" Maximum="24"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ToolTip="Stroke width"/>
                            <!-- Fixed width so the number does not shuffle the pill as it
                                 crosses from one digit to two. -->
                            <TextBlock x:Name="WidthText" Width="20" TextAlignment="Right"
                                       Foreground="{StaticResource Ink}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>

            <Grid Grid.Row="1" Margin="6,8,6,0">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource InkMuted}" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!--
                  Zoom was already here - Ctrl+wheel, Ctrl+0, Ctrl+1 - and there was no
                  way to find that out. A percentage you cannot click reads as a
                  readout for a control that exists somewhere else.
                -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Content="&#xE738;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource ZoomButton}"
                            ToolTip="Zoom out  (Ctrl+-)"/>

                    <!-- Fixed width so stepping through 100% to 75% does not shuffle
                         the buttons either side of it. -->
                    <TextBlock x:Name="ZoomText" Width="42" TextAlignment="Center"
                               Foreground="{StaticResource InkMuted}" FontSize="11"
                               VerticalAlignment="Center"/>

                    <Button x:Name="ZoomInButton" Content="&#xE710;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource ZoomButton}"
                            ToolTip="Zoom in  (Ctrl++)"/>

                    <Border Width="1" Background="#24F5F2EC" Margin="6,3,6,3"/>

                    <Button x:Name="ZoomFitButton" Content="Fit"
                            Style="{StaticResource ZoomButton}"
                            ToolTip="Fit to window  (Ctrl+0)"/>

                    <!-- "1:1" rather than "100%", which would be a button labelled the
                         same as the readout two inches to its left. -->
                    <Button x:Name="ZoomActualButton" Content="1:1"
                            Style="{StaticResource ZoomButton}"
                            ToolTip="Actual size  (Ctrl+1)"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
