<Window x:Class="Snipwhiz.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snipwhiz"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1C1B1A"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#26241F"/>
        <SolidColorBrush x:Key="Ink" Color="#F5F2EC"/>
        <SolidColorBrush x:Key="InkMuted" Color="#8F8A80"/>
        <SolidColorBrush x:Key="Accent" Color="#E8833A"/>

        <!-- The stock control templates are light-themed; on a #1C1B1A surface a
             default CheckBox is a white box with invisible text. These are the
             minimum needed to make the two controls legible, not a theme. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="#4A453D" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4"
                                      Stroke="#1C1B1A" StrokeThickness="2"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#1C1B1A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{StaticResource Accent}"
                                CornerRadius="6" Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#F09A57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,26,28,24">

        <TextBlock Text="Snipwhiz is running"
                   Foreground="{StaticResource Ink}"
                   FontSize="20" FontWeight="SemiBold"/>

        <TextBlock Text="It lives in the tray. There is no window to keep open."
                   Foreground="{StaticResource InkMuted}"
                   FontSize="13" Margin="0,4,0,20" TextWrapping="Wrap"/>

        <!--
          The headline, and deliberately the only large thing on this window. A
          tray app with a global hotkey has exactly one fact a person cannot
          discover by looking: the hotkey. Everything else here is secondary.
        -->
        <Border Background="{StaticResource SurfaceRaised}" CornerRadius="10" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Ctrl + Shift + 1"
                           Foreground="{StaticResource Accent}"
                           FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Drag a region. It lands on your clipboard."
                           Foreground="{StaticResource Ink}"
                           FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="4,14,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Shift + 2"
                       Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="the whole screen"
                       Foreground="{StaticResource InkMuted}" FontSize="13" Margin="12,0,0,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Shift + L"
                       Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold"
                       Margin="0,6,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="everything you have captured"
                       Foreground="{StaticResource InkMuted}" FontSize="13" Margin="12,6,0,0"/>
        </Grid>

        <CheckBox x:Name="Autostart" Content="Start Snipwhiz when I sign in"/>

        <!--
          Collapsed unless the Snipping Tool actually holds PrintScreen. Offering to
          take over a key nothing is using is a question with no meaning, and the
          startup path already claims it silently in that case.
        -->
        <CheckBox x:Name="PrintScreen" Visibility="Collapsed"
                  Content="Use PrintScreen for Snipwhiz instead of the Snipping Tool"/>

        <Button Content="Start capturing" Style="{StaticResource Primary}"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                IsDefault="True" Click="Dismiss"/>

    </StackPanel>
</Window>
