<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Snipwhiz.Core\Snipwhiz.Core.csproj" />
  </ItemGroup>

  <!-- The tools are internal and the x:Name fields WPF generates are internal, so
       the seam between the rail, the tools and the canvas is not reachable
       otherwise. That seam is where every App-layer bug in phase B lived. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Snipwhiz.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>Snipwhiz.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 assumes a pure WinForms app configured via Application.SetHighDpiMode.
         This app is WPF-hosted; DPI awareness is correctly declared in app.manifest
         (PerMonitorV2, required for correct monitor bounds), and WinForms is used
         only for the tray icon/menu, never for DPI configuration. -->
    <NoWarn>WFO0003</NoWarn>
  </PropertyGroup>

  <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 bundles a SQLite older than 3.50.2,
       which has a memory-corruption bug when aggregate terms outnumber
       available columns (CVE-2025-6965). No patched SQLitePCLRaw exists yet.
       Not reachable here: every statement in LibraryDb is static and
       parameterised, and none use aggregates. Remove this once a fixed
       SQLitePCLRaw ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- OverlayWindow calls SetWindowPos/GetWindowLong/SetWindowLong/GetWindowRect
       directly. Rather than granting App visibility into all of Core's internals
       (LibraryDb, CaptureStore, Settings, ...) via InternalsVisibleTo for the sake
       of three P/Invoke calls, App generates its own private copy of just the Win32
       surface it needs. Same package already in the repo (Core references it too),
       not a new dependency; PrivateAssets=all means nothing ships. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <!--
    Same reason as Snipwhiz.Core: System.Drawing arrives implicitly with
    UseWindowsForms and shadows Point, Size, Color, Brush and Pen — the WPF types
    the editor is built from. Removed from the implicit set so WPF wins by
    default; the tray, which is the only WinForms surface here, imports it
    explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <!--
      And System.Windows.Forms, which shadows the WPF input types: MouseEventArgs,
      MouseButtonEventArgs and KeyEventArgs all exist in both. Only TrayHost is
      WinForms, and it says so.
    -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
