<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Snipwhiz.Core\Snipwhiz.Core.csproj" />
  </ItemGroup>

  <!-- The tools are internal and the x:Name fields WPF generates are internal, so
       the seam between the rail, the tools and the canvas is not reachable
       otherwise. That seam is where every App-layer bug in phase B lived. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Snipwhiz.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF generates its own Main from App.xaml. Program.Main has to win, because
         Velopack's install hooks must run before WPF starts; see Program.cs. -->
    <StartupObject>Snipwhiz.App.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>Snipwhiz.App</RootNamespace>
    <!--
      What Windows calls this program. Both default to the assembly name, so every
      surface that reads the exe's metadata - Task Manager, the notification header,
      the file's Details tab - was calling it "Snipwhiz.App", which is a project name
      and not a product name.

      Deliberately not <AssemblyName>: that would rename the exe, and the exe name is
      load-bearing. release.ps1 passes it to vpk as the main exe, the Velopack
      shortcuts point at it, and the sandbox gate looks for it by name.
    -->
    <AssemblyTitle>Snipwhiz</AssemblyTitle>
    <Product>Snipwhiz</Product>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sets the icon on the exe itself, which is what Explorer, Alt+Tab, the
         taskbar and every WPF window's title bar read. Generated, not hand-drawn:
         see assets/icon/generate.cs. -->
    <ApplicationIcon>Snipwhiz.ico</ApplicationIcon>
    <!-- WFO0003 assumes a pure WinForms app configured via Application.SetHighDpiMode.
         This app is WPF-hosted; DPI awareness is correctly declared in app.manifest
         (PerMonitorV2, required for correct monitor bounds), and WinForms is used
         only for the tray icon/menu, never for DPI configuration. -->
    <NoWarn>WFO0003</NoWarn>
  </PropertyGroup>

  <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 bundles a SQLite older than 3.50.2,
       which has a memory-corruption bug when aggregate terms outnumber
       available columns (CVE-2025-6965). No patched SQLitePCLRaw exists yet.
       Not reachable here: every statement in LibraryDb is static and
       parameterised, and none use aggregates. Remove this once a fixed
       SQLitePCLRaw ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- OverlayWindow calls SetWindowPos/GetWindowLong/SetWindowLong/GetWindowRect
       directly. Rather than granting App visibility into all of Core's internals
       (LibraryDb, CaptureStore, Settings, ...) via InternalsVisibleTo for the sake
       of three P/Invoke calls, App generates its own private copy of just the Win32
       surface it needs. Same package already in the repo (Core references it too),
       not a new dependency; PrivateAssets=all means nothing ships. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <!--
    The verification harnesses do not ship. They are how this project's gates are
    run - each one env-gated, and nine of them able to sabotage real behaviour on
    purpose so a negative control has something to fail against. That is the right
    tool for a gate and the wrong thing to install on somebody's machine: a shipped
    build has no business carrying the code to make its own save throw or its own
    thumbnails leak.

    Excluded here, and every call site is inside #if DEBUG. Both are needed - the
    exclusion alone would not compile, and the guards alone would leave the harness
    in the binary. scripts\verify-atomic-write.ps1 already drives bin\Debug, so
    nothing that runs these is affected.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Diagnostics\**" />
  </ItemGroup>

  <!-- Also embedded as a resource, separately from ApplicationIcon. The tray needs
       to pick a specific frame out of the .ico at the size Windows is asking for,
       and ExtractAssociatedIcon only ever hands back 32px, which is then squashed
       to 16 and looks it. -->
  <ItemGroup>
    <Resource Include="Snipwhiz.ico" />
  </ItemGroup>

  <!--
    Same reason as Snipwhiz.Core: System.Drawing arrives implicitly with
    UseWindowsForms and shadows Point, Size, Color, Brush and Pen — the WPF types
    the editor is built from. Removed from the implicit set so WPF wins by
    default; the tray, which is the only WinForms surface here, imports it
    explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <!--
      And System.Windows.Forms, which shadows the WPF input types: MouseEventArgs,
      MouseButtonEventArgs and KeyEventArgs all exist in both. Only TrayHost is
      WinForms, and it says so.
    -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
