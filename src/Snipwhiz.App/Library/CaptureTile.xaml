<UserControl x:Class="Snipwhiz.App.Library.CaptureTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{Binding DataContext.TileWidth,
                     RelativeSource={RelativeSource AncestorType=Window},
                     FallbackValue=252}"
             Margin="0,0,16,16"
             Cursor="Hand">

    <!--
      Declared here, not in the window. StaticResource is resolved when this
      control is parsed, which happens before it is attached to the window's
      tree - so a converter living in Window.Resources is simply not found and
      the whole template throws.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
          The hover actions. Copy is the important one: it is the only way to get a
          stored capture back onto the clipboard once the preview screen is gone,
          and re-copying is the loop this whole product exists for.
        -->
        <Style x:Key="TileAction" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F2EC"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="7"
                                Background="#DC141312" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#F2332F28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileActionPrimary" TargetType="Button" BasedOn="{StaticResource TileAction}">
            <Setter Property="Foreground" Value="#1C1B1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="7"
                                Background="#E8833A" BorderThickness="0" Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#F09A57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card" CornerRadius="10" Padding="0"
            BorderThickness="1.5">
        <!--
          Background and BorderBrush are set only by the style. A local value on
          the element would win over a style setter and the hover trigger would
          silently do nothing.
        -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#26241F"/>
                <!--
                  The accent outline is gone. Selection is the marquee now, which
                  frees orange to mean "action" rather than doubling as "selected" -
                  see the design spec, section 3.7.
                -->
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Value="True"
                                 Binding="{Binding IsMouseOver,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Setter Property="Background" Value="#332F28"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel x:Name="CardContent">
            <!-- Fixed box so rows have a uniform height; the panel virtualizes
                 by row, and ragged row heights make its scroll estimates wrong. -->
            <!--
              The thumbnail fills its area rather than sitting inside a mat.
              A light mat was tried first and looked like what it was: a grey block.
              The problem it was solving - a dark capture with no visible edge on a
              dark tile - is better solved by removing the empty space entirely, so
              the picture IS the area and its own boundary is the tile's.

              UniformToFill crops rather than letterboxes, which is right for a
              contact sheet: a consistent grid of pictures beats a ragged grid of
              pictures with bands above and below. The hairline is what separates
              two dark captures sitting next to each other.
            -->
            <Grid Height="150" Background="#141312" ClipToBounds="True">
                <Image x:Name="Thumb"
                       Source="{Binding Thumbnail}"
                       Stretch="UniformToFill"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1"/>

                <!--
                  The marquee. Four corner brackets in the icon's four colours,
                  scaling in from slightly oversized like a viewfinder locking on.
                  This app's core gesture is dragging a selection rectangle, so
                  selection is the one place worth spending an idea.
                -->
                <Grid x:Name="Marquee" Margin="4" Opacity="0" IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MarqueeScale" ScaleX="1.06" ScaleY="1.06"/>
                    </Grid.RenderTransform>

                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                            BorderBrush="#FFA12E" BorderThickness="2.5,2.5,0,0" CornerRadius="3,0,0,0"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                            BorderBrush="#FF3D6E" BorderThickness="0,2.5,2.5,0" CornerRadius="0,3,0,0"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            BorderBrush="#A46BFF" BorderThickness="0,0,2.5,2.5" CornerRadius="0,0,3,0"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            BorderBrush="#1FE0B4" BorderThickness="2.5,0,0,2.5" CornerRadius="0,0,0,3"/>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsMissing,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="File missing"
                               Foreground="#C9C3B8" FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Dimensions}"
                               Foreground="#6E6960" FontSize="11" Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="RemoveButton"
                            Content="Remove from library"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#E8833A" FontSize="11"
                            Margin="0,8,0,0" Padding="6,3" Cursor="Hand"/>
                </StackPanel>

                <!--
                  Hidden until the pointer is over the tile, and hidden entirely for
                  a capture whose file is gone - there is nothing to copy, and the
                  only action that makes sense is the Remove button above.
                -->
                <StackPanel x:Name="HoverActions"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                    <Button x:Name="DeleteButton" Content="Delete"
                            Style="{StaticResource TileAction}" Margin="0,0,6,0"/>
                    <Button x:Name="CopyButton" Content="Copy"
                            Style="{StaticResource TileActionPrimary}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="12,9,12,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Caption}"
                           Foreground="#F5F2EC" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding TakenAt}"
                           Foreground="#8F8A80" FontSize="11"
                           Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
