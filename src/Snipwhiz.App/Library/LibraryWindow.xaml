<Window x:Class="Snipwhiz.App.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snipwhiz.App.Library"
        xmlns:core="clr-namespace:Snipwhiz.Core.Storage;assembly=Snipwhiz.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Snipwhiz Library"
        Width="1100" Height="720"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"

        Background="Transparent">

    <!--
      A real caption height, not the zero the plan asked for.

      Zero is the obvious way to get an app-drawn title bar and it is the expensive
      one: it tells Windows this window has no caption at all, and drag,
      double-click-to-maximise and the right-click system menu are things Windows
      does *to a caption*. Losing all three and reimplementing them with DragMove is
      how a custom title bar ends up worse than the stock one it replaced.

      Given a height instead, the top 56px behave like a caption and those three
      arrive for free. Anything up there that is a control rather than background -
      the tabs, Copy, minimise, close - opts out with IsHitTestVisibleInChrome. The
      maximise button deliberately does not; see CaptionChrome.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!--
      Transparent, and explicitly so. An opaque brush is painted across the whole
      client area and hides the Mica backdrop, leaving it visible only in the
      caption. Omitting the attribute is not the fix either: a Window's default
      Background is SystemColors.WindowBrush, so leaving it unset paints white.
      The flat fallback is applied in code, but only when the compositor actually
      refuses the backdrop.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#26241F"/>
        <SolidColorBrush x:Key="Ink" Color="#F5F2EC"/>
        <SolidColorBrush x:Key="InkMuted" Color="#8F8A80"/>
        <SolidColorBrush x:Key="Accent" Color="#E8833A"/>

        <!--
          The window buttons. Sized to Windows' own 46x32 rather than to this app's
          taste: these are the three controls a person operates without looking, and
          the muscle memory is for the standard target, in the standard order, in the
          standard corner. The only liberty taken is the colour.
        -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red on hover, because that is what Close does everywhere else in Windows
             and a close button that does not is a close button you hesitate over. -->
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#B01F12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit templates: the ContentPresenter for each row picks by type. -->
        <DataTemplate DataType="{x:Type core:DayHeaderRow}">
            <TextBlock Text="{Binding Label}"
                       Foreground="{StaticResource InkMuted}"
                       FontSize="12" FontWeight="SemiBold"
                       Margin="2,14,0,10"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TileRowViewModel}">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CaptureTile/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <!--
      Mica tints with the desktop wallpaper, so unmodified it makes text contrast
      a function of whatever image the user happens to have set. This scrim keeps
      the surface reliably dark while still letting the backdrop read through it.
    -->
    <Grid Background="#B21C1B1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
          One window, two screens. This replaces spec §4.15's pull-up sheet: the
          sheet existed so the library would not need a window of its own, and a
          view switch achieves that with one Mica surface, one Escape chain and
          one lifetime instead of two.
        -->
        <!--
          The caption. Everything in this row is either a control that opts out of the
          chrome, or background you can drag the window by - there is no separate
          title bar above it, which is the whole point: the tabs already say what this
          window is, so a strip repeating "Snipwhiz Library" above them would be 32px
          of vertical space spent on a label nobody reads.
        -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--
              Copy, shown only while editing. It saves before it copies, because the
              editor writes on the way out and copying the file as it stands would
              silently omit whatever was just drawn. See LibraryWindow.CopyFromEditor.
            -->
            <Button x:Name="EditorCopyButton" Grid.Column="1"
                    Content="Copy"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,18,4" Padding="18,7"
                    Background="{StaticResource Accent}" BorderThickness="0"
                    Foreground="#1C1B1A" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Visibility="Collapsed"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <!--
              The underline is a bottom border on the button, so it is exactly as wide
              as the word. It used to be a separate Border of Width="46" pulled back
              under the button with Margin="-46,0,0,0" - hand-measured to fit "Library",
              and wrong the moment the text, the font or the size changed.
            -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="28,16,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- The mark, at the size it was drawn for rather than a downscaled
                     256. Identity in the corner is the one thing the stock caption
                     was carrying that this row would otherwise drop. -->
                <Image Source="pack://application:,,,/Snipwhiz.ico"
                       Width="22" Height="22" Margin="0,0,14,8"
                       VerticalAlignment="Bottom"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel>
                    <Button x:Name="LibraryTab" Content="Library"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource Ink}"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="0,0,0,6" Cursor="Hand"/>
                    <Border x:Name="LibraryTabMark" Height="2" Background="{StaticResource Accent}"
                            Width="{Binding ActualWidth, ElementName=LibraryTab}"/>
                </StackPanel>

                <StackPanel Margin="26,0,0,0">
                    <Button x:Name="EditTab" Content="Edit"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource InkMuted}"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="0,0,0,6" Cursor="Hand"/>
                    <Border x:Name="EditTabMark" Height="2" Background="{StaticResource Accent}"
                            Width="{Binding ActualWidth, ElementName=EditTab}"
                            Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <!--
              Flush into the corner, where Windows puts them and where the pointer is
              thrown rather than aimed. Minimise and close opt out of the chrome so WPF
              handles them normally; maximise does NOT, because Windows only offers the
              Snap Layouts flyout to a window that answers WM_NCHITTEST with
              HTMAXBUTTON - and a button WPF is hit-testing never gets the chance to.
              CaptionChrome drives its hover and its click instead.
            -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimiseButton" Content="&#xE921;"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Minimise"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <Button x:Name="MaximiseButton" Content="&#xE922;"
                        Style="{StaticResource CaptionButton}"
                        Background="Transparent"/>

                <Button x:Name="CloseButton" Content="&#xE8BB;"
                        Style="{StaticResource CaptionClose}"
                        ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

    <Grid x:Name="RootContent" Grid.Row="1" Margin="28,14,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The capture count, moved up out of the footer so the header carries
                 the information and the footer can be a status line. -->
            <TextBlock x:Name="Tally" Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource InkMuted}"
                       FontSize="12.5"/>

            <!--
              A magnifier and a placeholder, because without them this was a plain
              rounded rectangle that read as a broken control rather than a search
              field. The placeholder is a TextBlock behind the TextBox rather than a
              watermark: WPF has no built-in one, and this is three lines.
            -->
            <Border Grid.Column="1"
                    x:Name="SearchBorder"
                    Background="{StaticResource SurfaceRaised}"
                    BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="9" Padding="12,7"
                    Width="300" HorizontalAlignment="Right">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Margin="0,0,9,0"
                          VerticalAlignment="Center"
                          Stroke="#6E6960" StrokeThickness="1.6"
                          Data="M 6.5,1.5 A 5,5 0 1 0 6.6,1.5 M 10.4,10.4 L 14,14"/>

                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                               Text="Search captures"
                               Foreground="#6E6960" FontSize="13"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Ink}"
                             CaretBrush="{StaticResource Accent}"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <ItemsControl x:Name="RowsHost"
                          ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">

                <!-- ItemsControl does not virtualize on its own: it needs a
                     virtualizing ItemsPanel AND an item-scrolling ScrollViewer.
                     Miss either and it silently realizes every row. -->
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller"
                                      CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True"
                                                VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="EmptyState"
                       Text="No captures yet.&#x0a;Press Ctrl+Shift+1 to capture a region."
                       Foreground="{StaticResource InkMuted}"
                       FontSize="15" TextAlignment="Center" LineHeight="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer -->
        <TextBlock x:Name="Footer"
                   Grid.Row="2" Margin="0,16,0,0"
                   Foreground="{StaticResource InkMuted}"
                   FontSize="12"/>
    </Grid>

        <!-- The Edit screen. Same row, shown instead of the library. -->
        <ContentControl x:Name="EditorHost" Grid.Row="1"
                        Margin="28,14,28,16" Visibility="Collapsed"/>

        <!-- Undo toast: an affordance instead of a confirmation dialog. -->
        <Border x:Name="UndoToast" Grid.Row="1"
                Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="#332F28" CornerRadius="8"
                BorderBrush="#454037" BorderThickness="1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UndoText"
                           Foreground="#F5F2EC" FontSize="13"
                           VerticalAlignment="Center"/>
                <Button x:Name="UndoButton"
                        Content="Undo"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#E8833A" FontSize="13" FontWeight="SemiBold"
                        Margin="16,0,0,0" Padding="6,2" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
