<Window x:Class="Snipwhiz.App.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snipwhiz.App.Library"
        xmlns:core="clr-namespace:Snipwhiz.Core.Storage;assembly=Snipwhiz.Core"
        Title="Snipwhiz Library"
        Width="1100" Height="720"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"

        Background="Transparent">

    <!--
      Transparent, and explicitly so. An opaque brush is painted across the whole
      client area and hides the Mica backdrop, leaving it visible only in the
      caption. Omitting the attribute is not the fix either: a Window's default
      Background is SystemColors.WindowBrush, so leaving it unset paints white.
      The flat fallback is applied in code, but only when the compositor actually
      refuses the backdrop.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#26241F"/>
        <SolidColorBrush x:Key="Ink" Color="#F5F2EC"/>
        <SolidColorBrush x:Key="InkMuted" Color="#8F8A80"/>
        <SolidColorBrush x:Key="Accent" Color="#E8833A"/>

        <!-- Implicit templates: the ContentPresenter for each row picks by type. -->
        <DataTemplate DataType="{x:Type core:DayHeaderRow}">
            <TextBlock Text="{Binding Label}"
                       Foreground="{StaticResource InkMuted}"
                       FontSize="12" FontWeight="SemiBold"
                       Margin="2,14,0,10"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TileRowViewModel}">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CaptureTile/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <!--
      Mica tints with the desktop wallpaper, so unmodified it makes text contrast
      a function of whatever image the user happens to have set. This scrim keeps
      the surface reliably dark while still letting the backdrop read through it.
    -->
    <Grid Background="#B21C1B1A">
    <Grid x:Name="RootContent" Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Library"
                       Foreground="{StaticResource Ink}"
                       FontSize="26" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceRaised}"
                    CornerRadius="8" Padding="12,7"
                    Width="260" HorizontalAlignment="Right">
                <TextBox x:Name="SearchBox"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Ink}"
                         CaretBrush="{StaticResource Accent}"
                         FontSize="13"
                         VerticalContentAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <ItemsControl x:Name="RowsHost"
                          ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">

                <!-- ItemsControl does not virtualize on its own: it needs a
                     virtualizing ItemsPanel AND an item-scrolling ScrollViewer.
                     Miss either and it silently realizes every row. -->
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller"
                                      CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True"
                                                VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="EmptyState"
                       Text="No captures yet.&#x0a;Press Ctrl+Shift+1 to capture a region."
                       Foreground="{StaticResource InkMuted}"
                       FontSize="15" TextAlignment="Center" LineHeight="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer -->
        <TextBlock x:Name="Footer"
                   Grid.Row="2" Margin="0,16,0,0"
                   Foreground="{StaticResource InkMuted}"
                   FontSize="12"/>
    </Grid>

        <!-- Preview sits above the grid in the same window (spec 2a §4.11). -->
        <ContentControl x:Name="PreviewHost" Margin="20,12,20,12"/>

        <!-- Undo toast: an affordance instead of a confirmation dialog. -->
        <Border x:Name="UndoToast"
                Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="#332F28" CornerRadius="8"
                BorderBrush="#454037" BorderThickness="1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UndoText"
                           Foreground="#F5F2EC" FontSize="13"
                           VerticalAlignment="Center"/>
                <Button x:Name="UndoButton"
                        Content="Undo"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#E8833A" FontSize="13" FontWeight="SemiBold"
                        Margin="16,0,0,0" Padding="6,2" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
