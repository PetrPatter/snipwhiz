<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Committed .ssproj files that must keep loading. A format change that breaks
    them is a format change that breaks every project a user has saved.

    Include, not Update: MSBuild's DefaultItemExcludes contains **/*.*proj, and
    our extension ends in "proj", so these are excluded from the default None
    items and there is nothing for Update to modify. It fails as files silently
    missing from the output directory rather than as a build error.
  -->
  <ItemGroup>
    <None Include="Fixtures\*.ssproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Snipwhiz.Core\Snipwhiz.Core.csproj" />
  </ItemGroup>

  <!-- Suppress transitive SQLite vulnerability (see Snipwhiz.Core.csproj) -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>